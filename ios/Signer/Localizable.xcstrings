    "Drag to move. Tap for the menu.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Verschieben. Tippen für das Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move. Tap for the menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para mover. Pulse para el menú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohistage liigutamiseks. Puudutage menüü avamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer. Touchez pour le menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare. Tocca per il menu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkite, kad perkeltumėte. Palieskite meniu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Velciet, lai pārvietotu. Pieskarieties, lai atvērtu izvēlni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby przesunąć. Stuknij, aby otworzyć menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы переместить. Коснитесь для меню."
          }
        }
      }
    },
