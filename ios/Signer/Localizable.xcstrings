    "Done — choose where to save the signed PDF.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig — wählen Sie, wo das signierte PDF gespeichert werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done — choose where to save the signed PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: elija dónde guardar el PDF firmado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis — valige, kuhu allkirjastatud PDF salvestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé — choisissez où enregistrer le PDF signé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto — scegli dove salvare il PDF firmato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlikta — pasirinkite, kur išsaugoti pasirašytą PDF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatavs — izvēlieties, kur saglabāt parakstīto PDF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe — wybierz, gdzie zapisać podpisany PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово — выберите, куда сохранить подписанный PDF."
          }
        }
