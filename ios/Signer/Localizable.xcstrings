    "Current signature. Tap Clear to draw it again.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Unterschrift. Tippen Sie auf Löschen, um sie neu zu zeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current signature. Tap Clear to draw it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma actual. Pulse Borrar para dibujarla de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Praegune allkiri. Puudutage «Tühjenda», et uuesti joonistada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature actuelle. Touchez Effacer pour la redessiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma attuale. Tocca Cancella per ridisegnarla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabartinis parašas. Palieskite „Išvalyti“, kad nupieštumėte iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašreizējais paraksts. Pieskarieties «Notīrīt», lai zīmētu no jauna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący podpis. Stuknij Wyczyść, aby narysować go ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая подпись. Нажмите «Очистить», чтобы нарисовать заново."
          }
        }
      }
    },
