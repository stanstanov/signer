    "In this mode each tap places a new signature, and you can drag each one separately.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Modus platziert jeder Tipp eine neue Unterschrift, und Sie können jede einzeln ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this mode each tap places a new signature, and you can drag each one separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este modo, cada toque coloca una firma nueva y puede arrastrar cada una por separado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles režiimis iga puudutus paigutab uue allkirja ja igaüht saab eraldi lohistada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ce mode, chaque toucher place une nouvelle signature, et vous pouvez faire glisser chacune séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa modalità ogni tocco posiziona una nuova firma e puoi trascinare ciascuna separatamente."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo režimu kiekvienas palietimas padeda naują parašą, ir kiekvieną galima vilkti atskirai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā režīmā katrs pieskāriens novieto jaunu parakstu, un katru var vilkt atsevišķi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym trybie każde stuknięcie stawia nowy podpis, a każdy można przeciągać osobno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом режиме каждое касание ставит новую подпись, и каждую можно двигать отдельно."
          }
        }
      }
    },
    "Multiple signature mode. Tap the PDF to place one.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus für mehrere Unterschriften. Tippen Sie auf das PDF, um eine zu platzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple signature mode. Tap the PDF to place one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de varias firmas. Pulse el PDF para colocar una."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitme allkirja režiim. Puudutage PDF-i, et paigutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode signatures multiples. Touchez le PDF pour en placer une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità firme multiple. Tocca il PDF per posizionarne una."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelių parašų režimas. Palieskite PDF, kad padėtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vairāku parakstu režīms. Pieskarieties PDF, lai novietotu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb wielu podpisów. Stuknij PDF, aby umieścić podpis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим нескольких подписей. Коснитесь PDF, чтобы поставить."
          }
        }
      }
    },
    "Multiple signature mode. Tap to add another; drag each one separately.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus für mehrere Unterschriften. Tippen Sie, um eine weitere hinzuzufügen; ziehen Sie jede einzeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
